{
  "name": "cityweather-plus",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/bulk/worker.js",
    "ops": "node dist/src/ops.js",
    "fixture": "node scripts/generate-fixture.cjs",
    "test:recovery": "npm run migrate && jest --runInBand bulk.integration",
    "test:large": "npm run migrate && node --max-old-space-size=128 scripts/test-large-admission.cjs",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathIgnorePatterns=integration",
    "test:integration": "jest --runInBand integration",
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bullmq": "6.3.15",
    "busboy": "1.6.0",
    "csv-parse": "7.0.3",
    "express": "5.3.0",
    "i18n-iso-countries": "7.14.0",
    "ioredis": "6.0.0",
    "redis": "6.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/busboy": "1.5.5",
    "@types/express": "5.0.5",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.0",
    "@types/supertest": "6.0.3",
    "jest": "30.5.2",
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "typescript": "5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
