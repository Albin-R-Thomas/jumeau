NODE_ENV=production
PORT=3000
API_KEY=replace-with-application-key
OPENWEATHER_API_KEY=replace-with-openweather-key
POSTGRES_DB=replace-with-database-name
POSTGRES_USER=replace-with-database-user
POSTGRES_PASSWORD=replace-with-database-password
DATABASE_URL=postgresql://replace-with-database-user:replace-with-database-password@postgres:5432/replace-with-database-name
REDIS_URL=redis://redis:6379
WEATHER_CACHE_TTL_SECONDS=900
PROVIDER_TIMEOUT_MS=5000
PROVIDER_MAX_RETRIES=2
PROVIDER_BASE_URL=https://api.openweathermap.org
PROVIDER_CALLS_PER_MINUTE=55
PROVIDER_CALLS_PER_MONTH=900000
BULK_UPLOAD_MAX_BYTES=10485760
BULK_UPLOAD_MAX_ROWS=100000
BULK_CITY_MAX_CODEPOINTS=200
BULK_UPLOAD_TIMEOUT_MS=120000
BULK_STAGING_DIR=/tmp/cityweather-uploads
BULK_DB_BATCH_SIZE=500
BULK_DISPATCH_BATCH_SIZE=500
BULK_WORKER_CONCURRENCY=5
BULK_RECONCILE_INTERVAL_MS=5000
BULK_LEASE_SECONDS=90
BULK_LEASE_HEARTBEAT_SECONDS=15
BULK_PENDING_BACKOFF_MAX_SECONDS=300
BULK_INVALID_PAYLOAD_MAX_ATTEMPTS=5
BULK_RETENTION_DAYS=30
GEO_REVERIFY_DAYS=30
PROVIDER_CONFIG_REVISION=initial
BULK_CURSOR_VERSION=1
